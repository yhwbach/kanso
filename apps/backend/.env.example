# ---- Server ----
PORT=3000
# Public URL of this backend (used for OAuth issuer and Tavus callback_url)
PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Leave empty to use an in-memory MongoDB (mongodb-memory-server) for local dev.
MONGODB_URI=
# Without MONGODB_URI, set this to a folder to keep the built-in database between restarts
MONGODB_DATA_DIR=

# ---- Local AI (Desert Ant Labs, runs on-device) ----
# on  = load Voz / Redact / Gist (models download from Hugging Face on first use)
# off = skip model loading; voice falls back to the browser's speech recognizer
LOCAL_AI=on
# Warm the models at startup so the first command is fast
PRELOAD_MODELS=true

# ---- Tavus (PAL + Magic Canvas) ----
TAVUS_API_KEY=
TAVUS_PAL_ID=
TAVUS_FACE_ID=
TAVUS_CONNECTOR_ID=

# ---- AWS Bedrock (voice-to-tool scaffolding) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# ---- MCP auth (OAuth 2.1 PKCE for Alexa+) ----
# required = every /mcp request needs a Bearer token from Kanso's OAuth server; apps link with a code from Link a device
# optional = unauthenticated MCP requests are also allowed, for local testing only
MCP_AUTH=required

# local = the web app's /api only answers this computer and your home network, never the tunnel (Tavus webhooks still get through)
# public = /api answers from anywhere, for a hosted frontend; it has no sign-in, so only use it behind your own access control
APP_ACCESS=local
